# SometeoPR Web App Configuration
DEV_MODE=false
APP_URL=https://angelclaims.example.com
DATABASE_PATH=/app/data/angelclaims.db

# Security
SECRET_KEY=change-me-to-a-random-string

# Inmediata API (to be provided by Inmediata)
INMEDIATA_API_URL=
INMEDIATA_API_KEY=
INMEDIATA_SUBMITTER_ID=
INMEDIATA_SFTP_HOST=sftp.inmediata.com
INMEDIATA_SFTP_USER=
INMEDIATA_SFTP_PASSWORD=
INMEDIATA_TEST_MODE=true

# Wink Integration
WINK_SYNC_URL=http://localhost:3100
WINK_DB_PATH=

# OpenAI (for AI scrub)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Twilio (fax)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FAX_FROM=

# Availity / Envolve Vision
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
AVAILITY_PAYER_ID=56190

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
